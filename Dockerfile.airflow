# Airflow image for the data-lineage POC (Kafka -> Airflow -> Spark -> Iceberg).
#
# Airflow is PURE ORCHESTRATION in this hop: it submits Spark apps
# (SparkSubmitOperator) and reads back Iceberg snapshot ids (pyiceberg). It never
# moves data itself.
#
# Why this image is deliberately thin:
# - deploy-mode cluster keeps the Spark DRIVER on a Spark worker, so the Airflow
#   container only needs the spark-submit client (pyspark) to submit the app.
# - The Iceberg runtime / Nessie / Kafka / OpenLineage jars live in the Spark image
#   (Dockerfile.spark), NOT here. Installing them here would duplicate jars and risk
#   version drift between the submitter and the executor.
# - confluent-kafka is intentionally NOT installed: Airflow never talks to Kafka;
#   only the Spark app (running on the worker) consumes topics.

FROM apache/airflow:3.2.2

# Versions pinned (D4): providers + pyiceberg must match the Airflow 3.2.2 base
# and the openlineage-spark 1.52.0 listener (spec 06 version-drift risk).
# Note: the apache/airflow image ships a pip wrapper that rejects `pip install`
# as root ("Please use 'airflow' user to run pip!"). Run as the default
# `airflow` user; the image's site-packages are writable by that user.
RUN pip install --no-cache-dir \
        apache-airflow-providers-apache-spark==6.3.2 \
        apache-airflow-providers-openlineage==2.20.1 \
        "pyiceberg[nessie,pyarrow,s3fs]==0.11.1" \
        pyspark==3.5.0
