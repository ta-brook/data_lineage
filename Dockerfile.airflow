# Airflow image for the data-lineage POC (Kafka -> Airflow -> Spark -> Iceberg).
#
# Airflow is PURE ORCHESTRATION in this hop: it submits Spark apps
# (SparkSubmitOperator) and reads back Iceberg snapshot ids (pyiceberg). It never
# moves data itself.
#
# Why this image is deliberately thin:
# - deploy-mode cluster keeps the Spark DRIVER on a Spark worker, so the Airflow
#   container only needs the spark-submit client (pyspark) to submit the app.
# - The Iceberg runtime / Nessie / Kafka / OpenLineage jars live in the Spark image
#   (Dockerfile.spark), NOT here. Installing them here would duplicate jars and risk
#   version drift between the submitter and the executor.
# - confluent-kafka is intentionally NOT installed: Airflow never talks to Kafka;
#   only the Spark app (running on the worker) consumes topics.

FROM apache/airflow:3.2.2

# Airflow 3 is a slimmed image with NO JVM or `ps` - but this hop uses the
# SparkSubmitOperator (spark-submit client) which requires Java + procps.
# Install OpenJDK 17 (Spark 3.5 supports 8/11/17) and procps (ps) as root,
# then restore the default airflow user.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps python3.11 python3.11-venv \
    && rm -rf /var/lib/apt/lists/* \
    && echo "export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64" >> /etc/bash.bashrc
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# PySpark driver/executor Python minor versions must match (EXE-02). In client
# deploy-mode the PySpark DRIVER runs in this container. The base image's default
# python is 3.13, but the Spark executors run Python 3.11 (Dockerfile.spark
# source-builds 3.11.9). Create a dedicated Python 3.11 venv (/opt/py311) with
# pyspark + the UDF deps, and point spark.pyspark.driver.python at it (config.py
# SPARK_CONF). Airflow itself stays on the base 3.13; only the PySpark driver uses
# the venv. A venv is used (not the system python3.11) because Debian's system
# python is PEP-668 externally-managed and rejects pip installs.
RUN python3.11 -m venv /opt/py311 \
    && /opt/py311/bin/pip install --no-cache-dir \
        pyspark==3.5.0 \
        fastavro==1.12.2 requests==2.32.4
# In client deploy-mode the PySpark driver runs in this container, so it needs
# the same Iceberg/Nessie/Kafka/Avro/OpenLineage/S3A jars as the Spark image
# (Dockerfile.spark). COPY them from a build context dir (jars/) - see the
# compose build context note; the versions mirror Dockerfile.spark exactly.
COPY jars/*.jar /opt/spark/jars/
# Client driver also needs the spark-defaults.conf (Nessie catalog, S3A mirror,
# OpenLineage listener) so the driver and workers agree on the catalog config.
COPY spark-defaults.conf /opt/spark/conf/spark-defaults.conf
USER airflow

# Versions pinned (D4): providers + pyiceberg must match the Airflow 3.2.2 base
# and the openlineage-spark 1.52.0 listener (spec 06 version-drift risk).
# Note: the apache/airflow image ships a pip wrapper that rejects `pip install`
# as root ("Please use 'airflow' user to run pip!"). Run as the default
# `airflow` user; the image's site-packages are writable by that user.
RUN pip install --no-cache-dir \
        apache-airflow-providers-apache-spark==6.3.2 \
        apache-airflow-providers-openlineage==2.20.1 \
        "pyiceberg[nessie,pyarrow,s3fs]==0.11.1" \
        pyspark==3.5.0 \
        fastavro==1.12.2 requests==2.32.4
